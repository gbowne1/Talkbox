{
  "name": "gbowne1/talkbox",
  "description": "TalkBox - Real-time chat application with WebSockets and REST API",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "cboden/ratchet": "^0.4",
    "symfony/routing": "^6.0",
    "symfony/http-foundation": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "TalkBox\\": "src/"
    }
  },
  "scripts": {
    "start-websocket": "php bin/websocket.php",
    "start-http": "php bin/http.php",
    "migrate": "mysql -u root -p talkbox < database/migrations/001_create_users.sql && ...",
    "analyze": "vendor/bin/phpstan analyse src --level 5",
    "start": "php bin/server.php"
  }
}
